---
import '../styles/global.css'

interface Props {
	title?: string;
	description?: string;
	wide?: boolean;
	ogType?: 'website' | 'article';
}

const { title = '장찬욱', description = '라즈베리파이 클러스터를 운영하며 배운 리눅스, 네트워크, 인프라 기록', wide = false, ogType = 'website' } = Astro.props;

const NAV_ITEMS = [
	{ href: '/blog', label: '글', match: (path: string, category: string | null) => path.startsWith('/blog') && category !== 'log' },
	{ href: '/blog?category=log', label: '로그', match: (path: string, category: string | null) => path.startsWith('/blog') && category === 'log' },
	{ href: '/projects', label: '프로젝트', match: (path: string) => path.startsWith('/projects') },
	{ href: '/about', label: '소개', match: (path: string) => path.startsWith('/about') },
];

const currentPath = Astro.url.pathname;
const canonicalUrl = Astro.site ? new URL(currentPath, Astro.site).href : null;
// prerender된 페이지에서는 쿼리 문자열을 읽을 수 없으므로 SSR 페이지에서만 category를 본다
const currentCategory = Astro.isPrerendered ? null : Astro.url.searchParams.get('category');
---
<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:locale" content="ko_KR" />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title="장찬욱 블로그" href="/rss.xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			// 첫 페인트 전에 저장된 테마를 적용해 깜빡임을 막는다
			try {
				const saved = localStorage.getItem('theme');
				if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
			} catch {}
		</script>
		<slot name="head" />
	</head>
	<body class="bg-ink-950 text-ink-300 min-h-screen flex flex-col">
		<nav id="main-nav" class="sticky top-0 z-40 bg-ink-950/90 backdrop-blur-md border-b border-ink-800/70 transition-shadow duration-200">
			<div class={`${wide ? 'max-w-5xl' : 'max-w-3xl'} mx-auto px-5 sm:px-6 h-14 flex justify-between items-center gap-4`}>
				<a href="/" class="font-mono text-[15px] text-ink-100 hover:text-accent transition-colors shrink-0" aria-label="홈으로">
					<span class="text-accent">~</span>/chanwook<span class="text-ink-600">$</span>
				</a>
				<div class="flex items-center gap-4 sm:gap-6 text-sm">
					{NAV_ITEMS.map(item => (
						<a
							href={item.href}
							class={item.match(currentPath, currentCategory)
								? 'text-ink-100 font-medium'
								: 'text-ink-500 hover:text-ink-100 transition-colors'}
						>{item.label}</a>
					))}
					<button id="theme-toggle" type="button" class="text-ink-500 hover:text-ink-100 transition-colors -mr-1 p-1" aria-label="테마 전환" title="테마 전환">
						<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="12" r="4.5" />
							<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
						</svg>
					</button>
				</div>
			</div>
		</nav>

		<main class={`${wide ? 'max-w-5xl' : 'max-w-3xl'} w-full mx-auto px-5 sm:px-6 py-12 sm:py-14 flex-1`}>
			<slot />
		</main>

		<footer class="border-t border-ink-800/70 mt-12">
			<div class={`${wide ? 'max-w-5xl' : 'max-w-3xl'} mx-auto px-5 sm:px-6 py-8 flex flex-col sm:flex-row gap-3 sm:justify-between sm:items-center text-xs font-mono text-ink-500`}>
				<span>&copy; 2026 장찬욱 · 라즈베리파이 위에서 직접 서빙 중</span>
				<div class="flex gap-5">
					<a href="/rss.xml" class="hover:text-accent transition-colors">rss</a>
					<a href="https://github.com/cjang3285" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">github</a>
					<a href="/status" class="hover:text-accent transition-colors">status</a>
				</div>
			</div>
		</footer>
	</body>
</html>

<script>
	const nav = document.getElementById('main-nav');
	const onScroll = () => {
		if (window.scrollY > 8) nav?.classList.add('scrolled');
		else nav?.classList.remove('scrolled');
	};
	window.addEventListener('scroll', onScroll, { passive: true });

	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const root = document.documentElement;
		const current = root.dataset.theme
			|| (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
		const next = current === 'dark' ? 'light' : 'dark';
		root.dataset.theme = next;
		try { localStorage.setItem('theme', next); } catch {}
	});
</script>

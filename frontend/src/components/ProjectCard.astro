---
interface Props {
	title: string;
	description: string;
	detailLink: string;
	githubUrl?: string;
	tags?: string[];
}

const { title, description, detailLink, githubUrl, tags = [] } = Astro.props;
---
<div class="group p-4 rounded-md border border-ink-800 hover:border-accent/60 transition-colors bg-ink-950">
	<div class="space-y-3">
		<a href={detailLink}>
			<h3 class="text-[15px] font-semibold text-ink-100 group-hover:text-accent transition-colors duration-200">
				{title}
			</h3>
		</a>
		<p class="text-ink-500 text-[13px] leading-relaxed">
			{description}
		</p>
		{tags.length > 0 && (
			<div class="flex flex-wrap gap-x-2.5 gap-y-1 font-mono text-[11.5px] text-ink-500">
				{tags.map(tag => (
					<span>
						{tag}
					</span>
				))}
			</div>
		)}
		{githubUrl && (
			<a
				href={githubUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1 font-mono text-xs text-ink-500 hover:text-accent transition-colors duration-200"
			>
				GitHub
				<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
				</svg>
			</a>
		)}
	</div>
</div>

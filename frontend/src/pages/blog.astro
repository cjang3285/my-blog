---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PostRow from '../components/PostRow.astro';
import PostEditorModal from '../components/PostEditorModal.astro';
import { fetchApi } from '../lib/api.js';
import { CATEGORIES, DEFAULT_CATEGORY, isCategory, groupByYear } from '../lib/post.js';

const POSTS_PER_PAGE = 20;
const SIDEBAR_TAG_LIMIT = 40;
const MOBILE_TAG_LIMIT = 15;

const params = Astro.url.searchParams;
const requestedCategory = params.get('category');
const category = isCategory(requestedCategory) ? requestedCategory : DEFAULT_CATEGORY;
const tag = params.get('tag');
const page = Math.max(1, parseInt(params.get('page') ?? '1', 10) || 1);

const postsQuery = new URLSearchParams({ page: String(page), limit: String(POSTS_PER_PAGE), category });
if (tag) postsQuery.set('tag', tag);

const [postsResult, countsResult, tagsResult] = await Promise.all([
	fetchApi(`/api/posts?${postsQuery}`),
	fetchApi('/api/posts/categories'),
	fetchApi(`/api/posts/tags?category=${category}`),
]);

const posts = postsResult.data?.posts ?? [];
const totalPages = postsResult.data?.totalPages ?? 1;
const total = postsResult.data?.total ?? 0;
const counts = Object.fromEntries((countsResult.data ?? []).map(({ category, count }) => [category, count]));
const tags = (tagsResult.data ?? []).slice(0, SIDEBAR_TAG_LIMIT);
const yearGroups = groupByYear(posts);
const isLog = category === 'log';

// 현재 필터를 유지하면서 일부 값만 바꾼 목록 URL
function listHref(overrides: { category?: string; tag?: string | null; page?: number }) {
	const next = new URLSearchParams();
	const nextCategory = overrides.category ?? category;
	const nextTag = overrides.tag === undefined ? tag : overrides.tag;
	const nextPage = overrides.page ?? 1;
	if (nextCategory !== DEFAULT_CATEGORY) next.set('category', nextCategory);
	if (nextTag) next.set('tag', nextTag);
	if (nextPage > 1) next.set('page', String(nextPage));
	const query = next.toString();
	return query ? `/blog?${query}` : '/blog';
}

function getPageNumbers(current: number, last: number): (number | '...')[] {
	const SIBLINGS = 1;
	const pages: (number | '...')[] = [1];
	const start = Math.max(2, current - SIBLINGS);
	const end = Math.min(last - 1, current + SIBLINGS);
	if (start > 2) pages.push('...');
	for (let p = start; p <= end; p++) pages.push(p);
	if (end < last - 1) pages.push('...');
	if (last > 1) pages.push(last);
	return pages;
}

const pageTitle = `${CATEGORIES[category].label}${tag ? ` #${tag}` : ''} - 장찬욱`;
---

<Layout title={pageTitle} description={CATEGORIES[category].description} wide={true}>
	<div class="flex gap-12">
		<div class="flex-1 min-w-0">
			<div class="flex justify-between items-start gap-4 mb-2">
				<h1 class="text-2xl font-bold text-ink-100 tracking-tight">{CATEGORIES[category].label}</h1>
				<button id="add-post-btn" style="display: none;" class="px-3 py-1.5 bg-accent hover:bg-accent-hover text-ink-950 rounded text-sm font-medium transition-colors">
					+ 새 글 작성
				</button>
			</div>
			<p class="text-sm text-ink-500 mb-7">{CATEGORIES[category].description}</p>

			<nav class="flex gap-5 border-b border-ink-800 mb-2 overflow-x-auto" aria-label="분류">
				{Object.entries(CATEGORIES).map(([key, { label }]) => (
					<a
						href={listHref({ category: key, tag: null })}
						class={`-mb-px pb-2.5 text-sm whitespace-nowrap border-b-2 transition-colors ${key === category
							? 'border-accent text-ink-100 font-medium'
							: 'border-transparent text-ink-500 hover:text-ink-200'}`}
						aria-current={key === category ? 'page' : undefined}
					>
						{label}<span class="ml-1.5 font-mono text-xs text-ink-500">{counts[key] ?? 0}</span>
					</a>
				))}
			</nav>

			{tag && (
				<div class="flex items-center gap-3 py-3 text-sm">
					<span class="font-mono text-accent">#{tag}</span>
					<span class="text-ink-500">{total}개</span>
					<a href={listHref({ tag: null })} class="ml-auto font-mono text-xs text-ink-500 hover:text-accent transition-colors">필터 해제 &times;</a>
				</div>
			)}

			{tags.length > 0 && (
				<div class="lg:hidden flex gap-2 overflow-x-auto py-3 -mx-5 px-5 sm:-mx-6 sm:px-6">
					{tags.slice(0, MOBILE_TAG_LIMIT).map(({ tag: name }) => (
						<a
							href={listHref({ tag: name === tag ? null : name })}
							class={`shrink-0 px-2.5 py-1 rounded border font-mono text-xs transition-colors ${name === tag
								? 'border-accent/60 text-accent bg-accent/10'
								: 'border-ink-800 text-ink-500 hover:text-ink-200'}`}
						>#{name}</a>
					))}
				</div>
			)}

			<div id="posts-container">
				{postsResult.error ? (
					<div class="text-center py-20">
						<p class="text-red-500 text-sm mb-2">글을 불러오는데 실패했습니다.</p>
						<p class="font-mono text-ink-500 text-xs">{postsResult.error}</p>
					</div>
				) : posts.length === 0 ? (
					<p class="text-center py-20 text-sm text-ink-500">해당하는 글이 없습니다.</p>
				) : (
					yearGroups.map(group => (
						<section class="pt-6">
							<h2 class="font-mono text-sm font-semibold text-ink-400 mb-1">{group.year}</h2>
							<div class="divide-y divide-ink-800/60">
								{group.posts.map(post => (
									<PostRow post={post} dateFormat="monthDay" showExcerpt={!isLog} showTags={!isLog} />
								))}
							</div>
						</section>
					))
				)}
			</div>

			{totalPages > 1 && (
				<nav id="pagination" class="flex items-center justify-center flex-wrap gap-1 mt-12 font-mono text-sm" aria-label="페이지 탐색">
					{page > 1 ? (
						<a href={listHref({ page: page - 1 })} class="px-3 py-1.5 rounded text-ink-400 hover:text-ink-100 hover:bg-ink-900">&larr;</a>
					) : (
						<span class="px-3 py-1.5 text-ink-700">&larr;</span>
					)}
					{getPageNumbers(page, totalPages).map(p => p === '...' ? (
						<span class="px-2 py-1.5 text-ink-600 select-none">&hellip;</span>
					) : p === page ? (
						<span class="px-3 py-1.5 rounded bg-accent text-ink-950 font-medium" aria-current="page">{p}</span>
					) : (
						<a href={listHref({ page: p })} class="px-3 py-1.5 rounded text-ink-400 hover:text-ink-100 hover:bg-ink-900">{p}</a>
					))}
					{page < totalPages ? (
						<a href={listHref({ page: page + 1 })} class="px-3 py-1.5 rounded text-ink-400 hover:text-ink-100 hover:bg-ink-900">&rarr;</a>
					) : (
						<span class="px-3 py-1.5 text-ink-700">&rarr;</span>
					)}
				</nav>
			)}
		</div>

		{tags.length > 0 && (
			<aside class="hidden lg:block w-52 shrink-0">
				<div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pr-1">
					<p class="font-mono text-xs text-ink-500 mb-3">tags</p>
					<nav class="flex flex-col">
						{tags.map(({ tag: name, count }) => (
							<a
								href={listHref({ tag: name === tag ? null : name })}
								class={`flex items-center justify-between gap-2 py-1 px-2 -mx-2 rounded text-[13px] transition-colors ${name === tag
									? 'bg-accent/10 text-accent font-medium'
									: 'text-ink-500 hover:text-ink-100 hover:bg-ink-900'}`}
							>
								<span class="truncate">{name}</span>
								<span class="font-mono text-[11px] text-ink-600 tabular-nums">{count}</span>
							</a>
						))}
					</nav>
				</div>
			</aside>
		)}
	</div>

	<PostEditorModal heading="새 글 작성" />
</Layout>

<script>
	const API_URL = import.meta.env.PUBLIC_API_URL || '';

	const modal = document.getElementById('post-modal');
	const form = document.getElementById('post-form') as HTMLFormElement | null;
	const addBtn = document.getElementById('add-post-btn');
	const field = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

	async function checkAuth() {
		try {
			const response = await fetch(`${API_URL}/api/auth/check`, { credentials: 'include' });
			const data = await response.json();
			if (addBtn && data.isAuthenticated) addBtn.style.display = 'block';
		} catch {
			// 비로그인 상태로 둔다
		}
	}

	addBtn?.addEventListener('click', () => {
		form?.reset();
		const current = new URLSearchParams(window.location.search).get('category');
		if (current) field<HTMLSelectElement>('post-category').value = current;
		modal?.classList.remove('hidden');
	});
	document.getElementById('cancel-btn')?.addEventListener('click', () => modal?.classList.add('hidden'));

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const tagsInput = field<HTMLInputElement>('post-tags').value;
		const body = {
			title: field<HTMLInputElement>('post-title').value,
			excerpt: field<HTMLTextAreaElement>('post-excerpt').value,
			content: field<HTMLTextAreaElement>('post-content').value,
			tags: tagsInput ? tagsInput.split(',').map(t => t.trim()).filter(Boolean) : [],
			category: field<HTMLSelectElement>('post-category').value,
			featured: field<HTMLInputElement>('post-featured').checked,
		};

		try {
			const response = await fetch(`${API_URL}/api/posts`, {
				method: 'POST',
				credentials: 'include',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(body),
			});
			if (!response.ok) throw new Error(`HTTP ${response.status}`);
			window.location.reload();
		} catch (error) {
			console.error('Failed to save post:', error);
			alert('저장에 실패했습니다.');
		}
	});

	checkAuth();
</script>

---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PostRow from '../components/PostRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { fetchApi } from '../lib/api.js';

const FEATURED_COUNT = 4;
const LATEST_ARTICLE_COUNT = 6;
const LATEST_LOG_COUNT = 5;
const PROJECT_COUNT = 2;

const [featuredResult, articlesResult, logsResult, projectsResult] = await Promise.all([
	fetchApi('/api/posts/featured'),
	fetchApi(`/api/posts?page=1&limit=${LATEST_ARTICLE_COUNT}&category=article`),
	fetchApi(`/api/posts?page=1&limit=${LATEST_LOG_COUNT}&category=log`),
	fetchApi('/api/projects'),
]);

const featuredPosts = (featuredResult.data ?? []).slice(0, FEATURED_COUNT);
const latestArticles = articlesResult.data?.posts ?? [];
const latestLogs = logsResult.data?.posts ?? [];
const recentProjects = (projectsResult.data ?? []).slice(0, PROJECT_COUNT);
---

<Layout title="장찬욱" description="라즈베리파이 클러스터를 운영하며 배운 리눅스, 네트워크, 인프라 기록">
	<Hero />

	{featuredPosts.length > 0 && (
		<section class="pb-14">
			<div class="flex items-baseline justify-between mb-4">
				<h2 class="text-sm font-semibold text-ink-100">먼저 읽어볼 글</h2>
			</div>
			<div class="grid sm:grid-cols-2 gap-3">
				{featuredPosts.map(post => (
					<a href={`/blog/${post.slug}`} class="group block p-4 rounded-md border border-ink-800 bg-ink-900/40 hover:border-accent/60 hover:bg-ink-900/80 transition-colors">
						<h3 class="text-[15px] font-semibold leading-snug text-ink-100 group-hover:text-accent transition-colors">{post.title}</h3>
						<p class="mt-2 text-[13px] leading-relaxed text-ink-500 line-clamp-3">{post.excerpt}</p>
					</a>
				))}
			</div>
		</section>
	)}

	<section class="pb-14">
		<div class="flex items-baseline justify-between mb-1 pb-2 border-b border-ink-800">
			<h2 class="text-sm font-semibold text-ink-100">최신 글</h2>
			<a href="/blog" class="font-mono text-xs text-ink-500 hover:text-accent transition-colors">전체 보기 &rarr;</a>
		</div>
		{latestArticles.length > 0 ? (
			latestArticles.map(post => <PostRow post={post} />)
		) : (
			<p class="py-10 text-center text-sm text-ink-500">
				{articlesResult.error ? `에러: ${articlesResult.error}` : '아직 글이 없습니다.'}
			</p>
		)}
	</section>

	<section class="pb-14">
		<div class="flex items-baseline justify-between mb-1 pb-2 border-b border-ink-800">
			<h2 class="text-sm font-semibold text-ink-100">개발 로그</h2>
			<a href="/blog?category=log" class="font-mono text-xs text-ink-500 hover:text-accent transition-colors">전체 로그 &rarr;</a>
		</div>
		<p class="text-xs text-ink-500 pt-3 pb-1">커밋과 PR 단위로 남기는 짧은 작업 기록입니다.</p>
		{latestLogs.length > 0 ? (
			latestLogs.map(post => <PostRow post={post} showExcerpt={false} showTags={false} />)
		) : (
			<p class="py-10 text-center text-sm text-ink-500">
				{logsResult.error ? `에러: ${logsResult.error}` : '아직 로그가 없습니다.'}
			</p>
		)}
	</section>

	<section class="pb-4">
		<div class="flex items-baseline justify-between mb-4 pb-2 border-b border-ink-800">
			<h2 class="text-sm font-semibold text-ink-100">최근 프로젝트</h2>
			<a href="/projects" class="font-mono text-xs text-ink-500 hover:text-accent transition-colors">전체 보기 &rarr;</a>
		</div>
		<div class="grid sm:grid-cols-2 gap-3">
			{recentProjects.length > 0 ? (
				recentProjects.map(project => (
					<ProjectCard
						title={project.title}
						description={project.description}
						detailLink={`/projects/${project.id}`}
						githubUrl={project.github_url}
						tags={project.stack || []}
					/>
				))
			) : (
				<p class="py-10 text-center text-sm text-ink-500 sm:col-span-2">
					{projectsResult.error ? `에러: ${projectsResult.error}` : '프로젝트가 없습니다.'}
				</p>
			)}
		</div>
	</section>
</Layout>

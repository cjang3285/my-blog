---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { fetchApi } from '../lib/api.js';

const { data: status, error } = await fetchApi('/api/status');

const GIB = 1024 ** 3;

function formatUptime(seconds: number) {
	const days = Math.floor(seconds / 86400);
	const hours = Math.floor((seconds % 86400) / 3600);
	const minutes = Math.floor((seconds % 3600) / 60);
	return days > 0 ? `${days}d ${hours}h ${minutes}m` : `${hours}h ${minutes}m`;
}

const metrics = status
	? [
		{ label: 'load avg (1m)', value: status.cpuLoad.toFixed(2) },
		{
			label: 'memory',
			value: `${((status.totalMem - status.freeMem) / GIB).toFixed(1)} / ${(status.totalMem / GIB).toFixed(1)} GiB`,
		},
		{ label: 'uptime', value: formatUptime(status.uptime) },
	]
	: [];
---

<Layout title="Status - 장찬욱" description="이 블로그를 서빙하는 라즈베리파이의 현재 상태">
	<h1 class="text-2xl font-bold text-ink-100 tracking-tight mb-2">Server Status</h1>
	<p class="text-sm text-ink-500 mb-10">이 블로그를 서빙하는 라즈베리파이 노드의 현재 상태입니다.</p>

	{error ? (
		<p class="font-mono text-sm text-red-500">상태를 불러오지 못했습니다: {error}</p>
	) : (
		<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
			{metrics.map(metric => (
				<div class="p-5 rounded-md border border-ink-800 bg-ink-900/40">
					<p class="font-mono text-xs text-ink-500 mb-2">{metric.label}</p>
					<p class="font-mono text-lg text-ink-100">{metric.value}</p>
				</div>
			))}
		</div>
	)}
</Layout>

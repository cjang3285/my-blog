---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import PostEditorModal from '../../components/PostEditorModal.astro';
import { fetchApi } from '../../lib/api.js';
import { CATEGORIES, formatDate, readingMinutes } from '../../lib/post.js';

const { slug } = Astro.params;
const API_URL = import.meta.env.PUBLIC_API_URL || '';
const { data: post, status } = await fetchApi(`/api/posts/${encodeURIComponent(slug ?? '')}`);

if (!post) {
	Astro.response.status = status === 404 ? 404 : 500;
}

const categoryInfo = post ? CATEGORIES[post.category as keyof typeof CATEGORIES] : null;
const listHref = post && post.category !== 'article' ? `/blog?category=${post.category}` : '/blog';
const tagHref = (tag: string) => `/blog?category=${post.category}&tag=${encodeURIComponent(tag)}`;

// 수정 모달에 채울 원본 데이터 (본문 HTML은 제외)
const editablePost = post && {
	id: post.id,
	slug: post.slug,
	title: post.title,
	excerpt: post.excerpt ?? '',
	content: post.content_markdown ?? '',
	tags: post.tags ?? [],
	featured: Boolean(post.featured),
	category: post.category,
};
---

<Layout
	title={post ? `${post.title} - 장찬욱` : '글을 찾을 수 없습니다 - 장찬욱'}
	description={post?.excerpt ?? '블로그 글 읽기'}
	ogType="article"
>
	{post?.has_math && (
		<link slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
	)}

	{!post ? (
		<div class="text-center py-20">
			<h1 class="text-2xl font-semibold text-ink-100 mb-4">
				{status === 404 ? '글을 찾을 수 없습니다' : '오류가 발생했습니다'}
			</h1>
			<p class="text-ink-500 text-sm mb-8">
				{status === 404 ? '요청하신 글이 존재하지 않거나 삭제되었습니다.' : '글을 불러오는 중 문제가 발생했습니다.'}
			</p>
			<a href="/blog" class="font-mono text-sm text-ink-500 hover:text-accent transition-colors">&larr; 글 목록으로</a>
		</div>
	) : (
		<article>
			<header class="mb-10">
				<a href={listHref} class="inline-block font-mono text-xs text-ink-500 hover:text-accent transition-colors mb-8">
					&larr; {categoryInfo?.label ?? '글'} 목록
				</a>
				<h1 class="text-[1.65rem] sm:text-[2rem] font-bold text-ink-100 leading-snug tracking-tight mb-4">{post.title}</h1>
				<div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-ink-500">
					<time datetime={post.date}>{formatDate(post.date)}</time>
					<span class="text-ink-700">/</span>
					<span>{readingMinutes(post.content_markdown)}분 분량</span>
					{post.category !== 'article' && (
						<>
							<span class="text-ink-700">/</span>
							<span class="text-accent">{categoryInfo?.label}</span>
						</>
					)}
				</div>
				{post.tags?.length > 0 && (
					<div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs">
						{post.tags.map((tag: string) => (
							<a href={tagHref(tag)} class="text-ink-500 hover:text-accent transition-colors">#{tag}</a>
						))}
					</div>
				)}
				<div id="admin-actions" class="hidden gap-2 mt-5">
					<button id="edit-btn" class="px-3 py-1 bg-ink-800 hover:bg-ink-700 rounded text-xs text-ink-300 font-medium transition-colors">수정</button>
					<button id="delete-btn" class="px-3 py-1 bg-red-500/15 hover:bg-red-500/25 text-red-500 rounded text-xs font-medium transition-colors">삭제</button>
				</div>
			</header>

			{post.excerpt && (
				<p class="text-[15.5px] leading-relaxed text-ink-400 border-l-2 border-accent pl-4 mb-10">{post.excerpt}</p>
			)}

			<div id="post-body" class="prose max-w-none" set:html={post.content_html || post.content_markdown || ''} />

			<footer class="mt-16 pt-6 border-t border-ink-800 flex flex-wrap justify-between gap-4 font-mono text-xs text-ink-500">
				<a href={listHref} class="hover:text-accent transition-colors">&larr; {categoryInfo?.label ?? '글'} 목록</a>
				<a href="/rss.xml" class="hover:text-accent transition-colors">RSS로 새 글 받아보기</a>
			</footer>
		</article>
	)}

	{editablePost && <PostEditorModal heading="글 수정" />}
</Layout>

{editablePost && (
	<script is:inline define:vars={{ editablePost, API_URL }}>
		const modal = document.getElementById('post-modal');
		const form = document.getElementById('post-form');
		const field = (id) => document.getElementById(id);

		async function checkAuth() {
			try {
				const response = await fetch(`${API_URL}/api/auth/check`, { credentials: 'include' });
				const data = await response.json();
				if (data.isAuthenticated) {
					const actions = field('admin-actions');
					actions.classList.remove('hidden');
					actions.classList.add('flex');
				}
			} catch {
				// 비로그인 상태로 둔다
			}
		}

		field('edit-btn')?.addEventListener('click', () => {
			field('post-id').value = editablePost.id;
			field('post-title').value = editablePost.title;
			field('post-excerpt').value = editablePost.excerpt;
			field('post-content').value = editablePost.content;
			field('post-tags').value = editablePost.tags.join(', ');
			field('post-category').value = editablePost.category;
			field('post-featured').checked = editablePost.featured;
			modal?.classList.remove('hidden');
		});

		field('cancel-btn')?.addEventListener('click', () => modal?.classList.add('hidden'));

		field('delete-btn')?.addEventListener('click', async () => {
			if (!confirm('정말 이 글을 삭제하시겠습니까?')) return;
			try {
				const response = await fetch(`${API_URL}/api/posts/${editablePost.id}`, { method: 'DELETE', credentials: 'include' });
				if (!response.ok) throw new Error(`HTTP ${response.status}`);
				alert('글이 삭제되었습니다.');
				window.location.href = '/blog';
			} catch (error) {
				console.error('Failed to delete post:', error);
				alert('삭제에 실패했습니다.');
			}
		});

		form?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const tagsInput = field('post-tags').value;
			const body = {
				title: field('post-title').value,
				excerpt: field('post-excerpt').value,
				content: field('post-content').value,
				tags: tagsInput ? tagsInput.split(',').map(t => t.trim()).filter(Boolean) : [],
				category: field('post-category').value,
				featured: field('post-featured').checked,
			};

			try {
				const response = await fetch(`${API_URL}/api/posts/${editablePost.id}`, {
					method: 'PUT',
					credentials: 'include',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(body),
				});
				if (!response.ok) throw new Error(`HTTP ${response.status}`);
				const updated = await response.json();
				// 제목이 바뀌면 slug도 바뀌므로 새 주소로 이동
				window.location.href = `/blog/${updated.slug}`;
			} catch (error) {
				console.error('Failed to save post:', error);
				alert('저장에 실패했습니다.');
			}
		});

		checkAuth();
	</script>
)}
